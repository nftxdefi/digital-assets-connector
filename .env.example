# Settings for ~/digital-assets/.env on the VPS. Copy the lines you need and fill them in.
# The real .env lives only on the VPS and in the password manager: never save it in this folder.

# --- required ---
# Cloudflare Tunnel token (from the tunnel's page in the Cloudflare dashboard)
TUNNEL_TOKEN=
# Secret part of the connector address (https://assets.swatfly.xyz/<this>/mcp). Generate with: openssl rand -hex 24
MCP_PATH_TOKEN=

# --- data providers ---
# Balances on Ethereum, Base, Arbitrum, Optimism, Polygon, and on-chain reads (free key, alchemy.com)
ALCHEMY_API_KEY=
# Transaction history for EVM chains and Solana (free Developer key, zerion.io; 300 requests a day)
ZERION_API_KEY=
# Solana balances (free key, helius.dev). Without it only SOL shows, no tokens.
HELIUS_API_KEY=
# Native coin prices, vault underlyings and USD/CAD
COINGECKO_API_KEY=
# demo (free key, api.coingecko.com) or pro (paid key, pro-api.coingecko.com)
COINGECKO_PLAN=demo
# Robinhood Chain balances (free key, dev.blockscout.com)
BLOCKSCOUT_API_KEY=

# Saved wallets, used when a question from chat lists no addresses: Nickname:address,Nickname:address
WALLETS=

# --- optional tuning (defaults shown; leave out unless needed) ---
# LOG_LEVEL=INFO
# CACHE_TTL_SECONDS=60
# ALCHEMY_MAX_PAGES=80
# HISTORY_SYNC_SECONDS=600
# HISTORY_WINDOW_DAYS=365
# HISTORY_COOL_SECONDS=900
# HISTORY_BUILD_SECONDS=300
# HISTORY_HL_MAX_CALLS=400
# RPC_URL_BASE=            (per chain: RPC_URL_<CHAIN>)
# BLOCKSCOUT_URL_ROBINHOOD= (per chain: BLOCKSCOUT_URL_<CHAIN>)
# HYPEREVM_RPC_URL=  HYPERLIQUID_INFO_URL=  MEMPOOL_URL=  SOLANA_RPC_URL=  BOC_VALET_URL=https://www.bankofcanada.ca/valet/observations
# CORE_TOKENS_FILE=  HYPEREVM_TOKENS_FILE=  DEFI_POSITIONS_FILE=  DATA_DIR=/data  PORT=8080
